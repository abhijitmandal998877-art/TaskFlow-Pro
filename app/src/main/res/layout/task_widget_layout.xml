<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TaskFlow Pro 🧸"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="0 Tasks"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/task_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• No pending tasks"
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:layout_marginBottom="6dp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/task_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:layout_marginBottom="6dp"
        android:singleLine="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/task_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:singleLine="true"
        android:visibility="gone" />

</LinearLayout>
