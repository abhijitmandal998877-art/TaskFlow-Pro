<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Inner Radial Glow Accent (Glow Behind Symbol) -->
    <path
        android:pathData="M54,26 C38.5,26 26,38.5 26,54 C26,69.5 38.5,82 54,82 C69.5,82 82,69.5 82,54 C82,38.5 69.5,26 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:color="#4D7000FF" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Outer Gold Accent Ring -->
    <path
        android:pathData="M54,32 C41.8,32 32,41.8 32,54 C32,66.2 41.8,76 54,76 C66.2,76 76,66.2 76,54 C76,41.8 66.2,32 54,32 Z"
        android:strokeWidth="1.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="76"
                android:endY="76"
                android:startX="32"
                android:startY="32"
                android:type="linear">
                <item android:color="#FFD700" android:offset="0.0" />  <!-- Gold -->
                <item android:color="#7000FF" android:offset="1.0" />  <!-- Accent Purple -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylish Cute Bear Ears Silhouette behind checkmark to match milestone mascot theme -->
    <path
        android:fillColor="#4D7000FF"
        android:pathData="M38,40 C34,40 32,44 34,48 C36,52 42,50 42,46 Z" />
    <path
        android:fillColor="#4D7000FF"
        android:pathData="M70,40 C74,40 76,44 74,48 C72,52 66,50 66,46 Z" />

    <!-- Ultimate Futuristic Checkmark with multi-colored gradient -->
    <path
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,54 L50,64 L68,44">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="68"
                android:endY="44"
                android:startX="40"
                android:startY="64"
                android:type="linear">
                <item android:color="#00FFF0" android:offset="0.0" />  <!-- Cyan Glow -->
                <item android:color="#7000FF" android:offset="0.5" />  <!-- Violet Core -->
                <item android:color="#FFD700" android:offset="1.0" />  <!-- Gold Tip -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Superfine Gold Inner Trace for high contrast and extreme premium visual feedback -->
    <path
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,54 L50,64 L68,44">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="68"
                android:endY="44"
                android:startX="40"
                android:startY="64"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#FFD700" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
